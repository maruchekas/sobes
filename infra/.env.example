# Скопируйте в .env и заполните перед запуском docker compose.

# Пароль PostgreSQL (обязателен, сгенерируйте: openssl rand -base64 24)
POSTGRES_PASSWORD=

# Секреты бэкенда. JWT_SECRET должен содержать минимум 32 символа.
TELEGRAM_BOT_TOKEN=
JWT_SECRET=

# Домен для Caddy: он же адрес приложения и источник сертификата Let's Encrypt
DOMAIN=

# Адрес бэкенда для серверного рендеринга фронтенда
API_URL=http://backend:8080
