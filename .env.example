# Скопируйте этот файл в .env.local и заполните локальные значения.
# Spring автоматически читает его при запуске из корня или backend/.
DB_URL=jdbc:postgresql://localhost:5432/sobes
DB_USER=sobes
DB_PASSWORD=sobes
TELEGRAM_BOT_TOKEN=123456789:AA-токен-от-BotFather
JWT_SECRET=минимум-32-символа-случайных-букв-и-цифр-0000

# LLM-оценка ответов мок-интервью (SOBES-28). Не задан — оценка отключена,
# отчёт живёт на самооценке + эталонах.
# Ключ: https://platform.deepseek.com -> API Keys
LLM_API_KEY=sk-ваш-ключ-deepseek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# Бот и внутренний API (для модуля bot/)
# BOT_INTERNAL_SECRET=случайная-строка-для-бота
# WEB_BASE_URL=http://localhost:3000
