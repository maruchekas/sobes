# Sobes — переменные окружения (пример).
# Backend (backend/): запускается с этими env, см. README.
TELEGRAM_BOT_TOKEN=123456789:AA-токен-от-BotFather
JWT_SECRET=минимум-32-символа-случайных-букв-и-цифр-0000

# Frontend (frontend/.env.local): NEXT_PUBLIC_* вшиваются в сборку.
# 1) Привязать домен боту: BotFather -> /setdomain -> sobes.localhost.dev
# 2) В hosts добавить: 127.0.0.1 sobes.localhost.dev
# 3) Открыть http://sobes.localhost.dev:3000/login
NEXT_PUBLIC_TELEGRAM_BOT=sobes_auth_bot
NEXT_PUBLIC_API_URL=http://sobes.localhost.dev:8080
