# Скопируйте этот файл в frontend/.env.local.
# NEXT_PUBLIC_* доступны в браузере, поэтому секретов здесь быть не должно.
# BotFather -> /setdomain должен быть настроен на sobes.localhost.dev.
NEXT_PUBLIC_TELEGRAM_BOT=sobes_auth_bot
# Публичный числовой id бота — часть TELEGRAM_BOT_TOKEN до двоеточия.
NEXT_PUBLIC_TELEGRAM_BOT_ID=123456789
NEXT_PUBLIC_API_URL=http://sobes.localhost.dev:8080
